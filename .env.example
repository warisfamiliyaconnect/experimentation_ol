# OLMo-2 Experiments Configuration Template
# Copy this file to '.env' and fill in your local settings.

# Local path to model weight artifacts
OLMO_MODEL_PATH=artifacts/OLMo-2-0425-1B-FP16

# Default YAML configuration file
OLMO_CONFIG_PATH=configs/inference_fp16.yaml

# Inference device (cuda | mps | cpu). Defaults to auto-detect.
OLMO_DEVICE=cuda

# Optional server endpoint URL for API client mode (e.g., http://localhost:8000)
OLMO_SERVER_URL=

# Central log file for inference response telemetry
OLMO_LOG_FILE=data/processed/inference_response.json
